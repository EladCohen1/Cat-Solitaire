Subject: [PATCH 2/2] Make the bet bar read one rung of three, not zero

The bar was configured with a floor of 1, which puts the bottom rung at no
fill at all: a slider fills by (value - min) / (max - min), so 1 of 1..3 is
0%. Floor is 0 and the value is the rung number, so rung one fills a third,
rung two two thirds, and the top rung fills it.

Configure also uses the arguments it is given again. Taking the range from
the inspector instead means a level whose ladder has four rungs quietly
fills a bar built for three.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QrRago1qqYWQbUSsLQBNqH
---
 .../Assets/Dev/Meta/View/LevelPriceInfoWindow.cs  | 15 ++++++++++-----
 Cat Solitaire/Assets/Dev/Meta/View/RewardBar.cs   | 10 ++++++++--
 2 files changed, 18 insertions(+), 7 deletions(-)

diff --git a/Cat Solitaire/Assets/Dev/Meta/View/LevelPriceInfoWindow.cs b/Cat Solitaire/Assets/Dev/Meta/View/LevelPriceInfoWindow.cs
index f5791d7..64504d4 100644
--- a/Cat Solitaire/Assets/Dev/Meta/View/LevelPriceInfoWindow.cs	
+++ b/Cat Solitaire/Assets/Dev/Meta/View/LevelPriceInfoWindow.cs	
@@ -82,8 +82,8 @@ public class LevelPriceInfoWindow : MonoBehaviour
 
         if (_bar != null)
         {
-            _bar.Configure(1, Mathf.Max(1, TierCount));
-            _bar.SetValue(1);
+            _bar.Configure(0, TierCount);
+            _bar.SetValue(BarValueFor(_tier));
         }
 
         Refresh();
@@ -102,12 +102,12 @@ public class LevelPriceInfoWindow : MonoBehaviour
         
         if (Ladder != null && !Ladder.IsUnlocked(wanted, LevelNumber))
         {
-            if (_bar != null) _bar.SetValue(_tier);
+            if (_bar != null) _bar.SetValue(BarValueFor(_tier));
             return;
         }
 
         _tier = wanted;
-        if (_bar != null) _bar.SetValue(_tier);
+        if (_bar != null) _bar.SetValue(BarValueFor(_tier));
 
         Refresh();
     }
@@ -123,7 +123,12 @@ public class LevelPriceInfoWindow : MonoBehaviour
 
     int LevelNumber => _ladder != null ? _ladder.CurrentNumber : 1;
 
-    void OnBarMoved(int value) => SelectTier(value);
+    void OnBarMoved(int value) => SelectTier(TierFor(value));
+
+    // The bar reads as rungs filled, so the bottom rung is 1 of 3, not 0 of 3.
+    static int BarValueFor(int tier) => tier + 1;
+
+    static int TierFor(int barValue) => barValue - 1;
 
     void OnCurrencyChanged(CurrencyDef _)
     {
diff --git a/Cat Solitaire/Assets/Dev/Meta/View/RewardBar.cs b/Cat Solitaire/Assets/Dev/Meta/View/RewardBar.cs
index 0af36c9..1354cee 100644
