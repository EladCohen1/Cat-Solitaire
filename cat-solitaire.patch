Subject: [PATCH 1/2] Give each hub object its own id

Cratel Cat and Carpet Cat were duplicated from Sofa Cat and kept its id.
Unlocks are saved by id, so buying any one of them marked all three bought
and the chapter read 3/3 on the first purchase.

ProgressionService now logs an error naming the objects when a chapter
holds the same id twice, since duplicating an asset and forgetting to
rename it is the obvious way back into this.

Any save made before this has "sofa-cat" in it, so all three will still
read as unlocked until Reset Save.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QrRago1qqYWQbUSsLQBNqH
---
 .../Dev/Content/Hub Objects/Carpet Cat.asset  |  2 +-
 .../Dev/Content/Hub Objects/Cratel Cat.asset  |  2 +-
 .../Meta/Progression/ProgressionService.cs    | 25 ++++++++++++++++++-
 3 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/Cat Solitaire/Assets/Dev/Content/Hub Objects/Carpet Cat.asset b/Cat Solitaire/Assets/Dev/Content/Hub Objects/Carpet Cat.asset
index 3dfe989..92925dd 100644
--- a/Cat Solitaire/Assets/Dev/Content/Hub Objects/Carpet Cat.asset	
+++ b/Cat Solitaire/Assets/Dev/Content/Hub Objects/Carpet Cat.asset	
@@ -12,7 +12,7 @@ MonoBehaviour:
   m_Script: {fileID: 11500000, guid: 5282f80593507b643a353ef2b1bd8033, type: 3}
   m_Name: Carpet Cat
   m_EditorClassIdentifier: Meta::HubObjectDef
-  Id: sofa-cat
+  Id: carpet-cat
   DisplayName: Sofa Cat
   Cost:
     Costs:
diff --git a/Cat Solitaire/Assets/Dev/Content/Hub Objects/Cratel Cat.asset b/Cat Solitaire/Assets/Dev/Content/Hub Objects/Cratel Cat.asset
index 98f74bc..db955e4 100644
--- a/Cat Solitaire/Assets/Dev/Content/Hub Objects/Cratel Cat.asset	
+++ b/Cat Solitaire/Assets/Dev/Content/Hub Objects/Cratel Cat.asset	
@@ -12,7 +12,7 @@ MonoBehaviour:
   m_Script: {fileID: 11500000, guid: 5282f80593507b643a353ef2b1bd8033, type: 3}
   m_Name: Cratel Cat
   m_EditorClassIdentifier: Meta::HubObjectDef
-  Id: sofa-cat
+  Id: cratel-cat
   DisplayName: Sofa Cat
   Cost:
     Costs:
diff --git a/Cat Solitaire/Assets/Dev/Meta/Progression/ProgressionService.cs b/Cat Solitaire/Assets/Dev/Meta/Progression/ProgressionService.cs
index bc5bae8..4ad64e4 100644
--- a/Cat Solitaire/Assets/Dev/Meta/Progression/ProgressionService.cs	
+++ b/Cat Solitaire/Assets/Dev/Meta/Progression/ProgressionService.cs	
@@ -1,4 +1,5 @@
 using System;
+using System.Collections.Generic;
 using System.Linq;
 using UnityEngine;
 
@@ -13,7 +14,29 @@ public class ProgressionService
     public event Action ChapterRewardClaimed;
 
     public ProgressionService(PlayerProfile p, Wallet w, HubChapterDef c)
-    { _profile = p; _wallet = w; _chapter = c; }
+    { _profile = p; _wallet = w; _chapter = c; WarnAboutSharedIds(); }
+
+    /// <summary>
+    /// Unlocks are saved by id, so two objects sharing one are bought together and
+    /// counted twice — progress jumps straight to full on the first purchase.
+    /// Duplicating an asset and forgetting to rename the id is the usual way in.
+    /// </summary>
+    void WarnAboutSharedIds()
+    {
+        if (_chapter == null || _chapter.Objects == null) return;
+
+        var seen = new HashSet<string>();
+
+        foreach (var o in _chapter.Objects)
+        {
+            if (o == null) continue;
+
+            if (!seen.Add(o.Id))
+                Debug.LogError(
+                    $"{_chapter.name}: '{o.name}' reuses the id '{o.Id}'. Unlocking any one of them unlocks them all.",
+                    _chapter);
+        }
+    }
 
     public HubChapterDef Chapter => _chapter;
 
